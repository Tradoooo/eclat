# Vérifications faites le 2026-11-12 (11 h–12 h Europe/Paris) via l'API GitHub,
# raw.githubusercontent.com et lecture directe des fichiers téléchargés.

[wamr]
upstream      = https://github.com/bytecodealliance/wasm-micro-runtime
nom_court     = WAMR (WebAssembly Micro Runtime)
version       = WAMR-2.4.5            # VÉRIFIÉ : tag réel, release publiée le 2026-06-29
commit        = 25bd7eb63e828e4bd242cc9b38d260b4b31c6605   # VÉRIFIÉ : git rev-parse HEAD du clone
branche       = main                  # VÉRIFIÉ : branche par défaut
licence       = Apache-2.0 WITH LLVM-exception   # VÉRIFIÉ : ligne 204 du LICENSE amont
artefact      = product-mini/platforms/linux/build/libiwasm.a   # VÉRIFIÉ : construit et lié
cible_qnx     = absente               # VÉRIFIÉ : ni core/shared/platform/qnx ni product-mini/platforms/qnx
# Options de build réellement utilisées (noms VÉRIFIÉS dans doc/build_wamr.md amont) :
options       = INTERP=1 FAST_INTERP=1 AOT=0 JIT=0 LIBC_BUILTIN=1 LIBC_WASI=0 THREAD_MGR=0 TARGET=X86_64 PLATFORM=linux

[outil_wasm]
wasi_sdk        = 34.0                # VÉRIFIÉ
wasi_sdk_tag    = wasi-sdk-34         # VÉRIFIÉ : release du 2026-08-25
wasi_sdk_url    = https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-x86_64-linux.tar.gz
wasi_sdk_sha256 = b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4   # VÉRIFIÉ, contrôlé par tools/fetch-deps.sh
wasi_sdk_octets = 192383077           # VÉRIFIÉ
compilateur     = clang-23 (--target=wasm32)   # VÉRIFIÉ : bin/clang -> clang-23

[qnx]
sdp           = 8.0
arbre_ports   = https://github.com/qnx-ports/build-files
cibles        = aarch64le, x86_64     # VÉRIFIÉ : mêmes cibles que ports/zlib (nto-aarch64-le, nto-x86_64-o)
compilateur   = qcc / q++             # VÉRIFIÉ dans ports/zlib/qnx.nto.toolchain.cmake
sdp_installe  = non                   # BLOQUANT pour les lots L7 à L10 et pour l'essai E2

[hote_developpement]
os            = Ubuntu 24.04 (x86_64)
gcc           = 13.3.0                # VÉRIFIÉ : gcc --version
cmake         = 3.30.5                # VÉRIFIÉ : cmake --version (correction : noté « absent » à tort le 11/11)
ninja         = absent                # VÉRIFIÉ : cmake utilise le générateur Unix Makefiles
python        = 3.12.3                # VÉRIFIÉ : tomllib disponible en stdlib
make          = 4.3                   # VÉRIFIÉ

[piege_environnement]
# VÉRIFIÉ le 2026-11-12 : le toolchain wasi-sdk invoque un `wasm-opt` trouvé dans PATH.
# Celui de ~/.local/bin est un script Node ESM cassé sous Node 26 (« require is not defined in
# ES module scope »), ce qui fait échouer l'édition de liens. Le Makefile impose donc un PATH
# propre pour la compilation wasm (variable WASM_PATH).
wasm_opt_casse = ~/.local/bin/wasm-opt