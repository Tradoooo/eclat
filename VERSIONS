wasi_sdk_octets = 192383077           # VÉRIFIÉ
compilateur     = clang-23 (--target=wasm32)   # VÉRIFIÉ : bin/clang -> clang-23

[qnx]
sdp           = 8.0
sdp_installe  = OUI                   # VÉRIFIÉ le 2026-11-12 : /home/baptiste/qnx800 (5,9 Go)
sdp_chemin    = /home/baptiste/qnx800 # QNX_HOST=host/linux/x86_64, QNX_TARGET=target/qnx
qcc           = 12.2.0                # VÉRIFIÉ : qcc --version ; binutils 2.43.0, gdb 14.2
variantes     = gcc_ntox86_64 (défaut), gcc_ntoaarch64le, + variantes _cxx/_gpp   # VÉRIFIÉ : qcc -V
